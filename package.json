    "expo-status-bar": "~1.4.2",
    "firebase": "^9.17.1",
    "graphql": "^15.8.0",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-native": "0.70.8",
    "react-native-safe-area-context": "4.4.1",
